<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="DemoQA Suite" parallel="tests" thread-count="2">

    <!-- Extent Reports Listener -->
    <listeners>
        <listener class-name="com.demoqa.tests.TestListener"/>
    </listeners>

    <!-- Chrome Execution -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.demoqa.tests.LoginTests"/>
            <class name="com.demoqa.tests.LoginDataDrivenTests"/>
            <class name="com.demoqa.tests.PracticeFormTests"/>
            <class name="com.demoqa.tests.WebTablesTests"/>
            <class name="com.demoqa.tests.CheckBoxTests"/>
        </classes>
    </test>

    <!-- Firefox Execution -->
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.demoqa.tests.LoginTests"/>
            <class name="com.demoqa.tests.LoginDataDrivenTests"/>
            <class name="com.demoqa.tests.PracticeFormTests"/>
            <class name="com.demoqa.tests.WebTablesTests"/>
            <class name="com.demoqa.tests.CheckBoxTests"/>
        </classes>
    </test>

</suite>
